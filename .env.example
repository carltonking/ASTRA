# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ASTRA_LLM_PROVIDER=anthropic

# Data sources
LSEG_APP_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Broker (default: alpaca)
ASTRA_BROKER=alpaca
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_PAPER_URL=https://paper-api.alpaca.markets
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=
TRADIER_TOKEN=
TRADIER_ACCOUNT_ID=

# Notifications
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=

# Storage
ASTRA_BUILD_DIR=.astra_builds
ASTRA_EXPORT_DIR=.astra_exports
ASTRA_DB_PATH=.astra/astra.db
ASTRA_DATABASE_URL=postgresql+asyncpg://astra:astra@localhost:5432/astra
ASTRA_REDIS_URL=redis://localhost:6379/0
ASTRA_ENABLE_PRODUCTION_PERSISTENCE=0
ASTRA_ENABLE_DURABLE_EVENTS=0
ASTRA_ENABLE_REDIS_EVENTS=0
ASTRA_API_KEY=
ASTRA_RATE_LIMIT_PER_MINUTE=120
ASTRA_ENABLE_MANUAL_PAPER_ORDERS=0

# Graduation gates
# DSR is a probability in [0,1] (confidence the edge is real); 0.95 = 95%%.
MIN_DSR=0.95
MIN_ANNUAL_RETURN=0.05
MAX_DRAWDOWN=0.20
MIN_TRADES=20
MAX_DEGRADATION=0.2
MIN_CALENDAR_DAYS=5

# Alpha Vantage outputsize: "compact" (free, ~100 pts) or "full" (premium)
ASTRA_ALPHAVANTAGE_OUTPUTSIZE=compact
